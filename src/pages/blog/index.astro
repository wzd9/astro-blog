---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`博客 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body class="blog-index-page">
		<Header />
		<main class="blog-index-main">
			<header class="page-heading">
				<p class="section-kicker">THE BLOG / NOTES FROM PRACTICE</p>
				<h1>博客</h1>
				<p>关于开发、运维与自建服务的实践记录。<span>目前收录 {posts.length} 篇文章。</span></p>
			</header>

			{featured && (
				<a class="featured-card" href={`/blog/${featured.id}/`}>
					<div class="featured-cover">
						{featured.data.heroImage ? <Image src={featured.data.heroImage} alt="" width={900} height={560} /> : <div class="cover-placeholder"><span>FEATURED NOTE</span></div>}
					</div>
					<div class="featured-body">
						<p class="featured-label"><span class="featured-dot"></span> 最新文章</p>
						<h2>{featured.data.title}</h2>
						<p class="description">{featured.data.description}</p>
						<div class="card-meta"><FormattedDate date={featured.data.pubDate} />{featured.data.tags?.[0] && <span class="tag">{featured.data.tags[0]}</span>}</div>
						<span class="read-link">阅读全文 <span aria-hidden="true">↗</span></span>
					</div>
				</a>
			)}

			<section class="archive" aria-labelledby="archive-heading">
				<div class="archive-heading"><h2 id="archive-heading">全部文章</h2><span>{rest.length} 篇</span></div>
				<div class="post-list">
					{rest.map((post) => (
						<a class="post-row" href={`/blog/${post.id}/`}>
							<div class="row-cover">
								{post.data.heroImage ? <Image src={post.data.heroImage} alt="" width={360} height={240} /> : <div class="cover-placeholder"><span>NOTE</span></div>}
							</div>
							<div class="row-content">
								<div class="card-meta"><FormattedDate date={post.data.pubDate} />{post.data.tags?.[0] && <span class="tag">{post.data.tags[0]}</span>}</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<span class="read-link">阅读文章 <span aria-hidden="true">→</span></span>
							</div>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-index-main { padding-top: 3.3rem; }
	.page-heading { max-width: 800px; margin: 0 0 2.2rem; }
	.section-kicker { margin: 0 0 0.65rem; color: var(--accent); font: 700 0.7rem/1.5 var(--font-mono); letter-spacing: 0.12em; }
	.page-heading h1 { margin: 0 0 0.55rem; font-size: clamp(2.25rem, 5vw, 3rem); letter-spacing: -0.05em; }
	.page-heading > p:last-child { margin: 0; color: rgb(var(--gray)); font-size: 1rem; }
	.page-heading > p:last-child span { margin-left: 0.5rem; color: rgb(var(--gray)); font-size: 0.84rem; }
	.featured-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-card); color: inherit; text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; }
	.featured-card:hover { transform: translateY(-2px); box-shadow: var(--box-shadow); }
	.featured-cover { min-height: 340px; overflow: hidden; background: var(--color-surface-muted); }
	.featured-cover :global(img) { width: 100%; height: 100%; min-height: 340px; object-fit: cover; transition: transform 0.4s ease; }
	.featured-card:hover .featured-cover :global(img) { transform: scale(1.025); }
	.cover-placeholder { display: grid; place-items: center; width: 100%; height: 100%; min-height: 220px; background: linear-gradient(135deg, #1e40af, #2563eb 60%, #38bdf8); color: #fff; font: 700 0.75rem/1 var(--font-mono); letter-spacing: 0.14em; }
	.featured-body { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(1.5rem, 4vw, 3rem); }
	.featured-label { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1.1rem; color: var(--accent); font-size: 0.78rem; font-weight: 700; }
	.featured-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
	.featured-body h2 { margin: 0 0 0.85rem; font-size: clamp(1.45rem, 2.7vw, 2rem); line-height: 1.4; letter-spacing: -0.03em; }
	.description { margin: 0 0 1.2rem; color: rgb(var(--gray)); font-size: 0.93rem; line-height: 1.8; }
	.card-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 0.7rem; color: rgb(var(--gray)); font-size: 0.75rem; }
	.tag { padding: 0.12rem 0.48rem; border-radius: 5px; background: var(--accent-soft); color: var(--accent); font-size: 0.69rem; }
	.read-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: auto; padding-top: 1.35rem; color: var(--accent); font-size: 0.83rem; font-weight: 650; }
	.archive { margin-top: 3.5rem; }
	.archive-heading { display: flex; align-items: baseline; gap: 0.65rem; margin-bottom: 1rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--color-border); }
	.archive-heading h2 { margin: 0; font-size: 1.28rem; }
	.archive-heading > span { color: rgb(var(--gray)); font-size: 0.78rem; }
	.post-list { display: grid; gap: 0.8rem; }
	.post-row { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 1.35rem; padding: 0.75rem; border: 1px solid transparent; border-radius: var(--radius-md); color: inherit; text-decoration: none; transition: border-color 0.18s ease, background-color 0.18s ease; }
	.post-row:hover { border-color: var(--color-border); background: var(--color-surface); }
	.row-cover { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 9px; background: var(--color-surface-muted); }
	.row-cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
	.row-content { display: flex; flex-direction: column; align-items: flex-start; padding: 0.35rem 0.25rem; }
	.row-content h3 { margin: 0.4rem 0; font-size: 1.05rem; line-height: 1.5; }
	.row-content > p { display: -webkit-box; overflow: hidden; margin: 0 0 0.6rem; color: rgb(var(--gray)); font-size: 0.84rem; line-height: 1.75; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
	.row-content .read-link { padding-top: 0; font-size: 0.76rem; }
	@media (max-width: 720px) {
		.blog-index-main { padding-top: 2rem; }
		.page-heading { margin-bottom: 1.5rem; }
		.page-heading > p:last-child span { display: block; margin: 0.25rem 0 0; }
		.featured-card { grid-template-columns: 1fr; border-radius: var(--radius-md); }
		.featured-cover,
		.featured-cover :global(img) { min-height: 0; height: auto; aspect-ratio: 16 / 9; }
		.featured-body { min-height: 250px; padding: 1.3rem; }
		.archive { margin-top: 2.5rem; }
		.post-row { grid-template-columns: 112px minmax(0, 1fr); gap: 0.8rem; padding: 0.5rem 0; }
		.row-content h3 { margin: 0.3rem 0; font-size: 0.9rem; }
		.row-content > p { font-size: 0.77rem; -webkit-line-clamp: 2; }
		.row-cover { align-self: start; }
	}
</style>
