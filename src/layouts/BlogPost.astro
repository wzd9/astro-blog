---
import Giscus from '../components/Giscus.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Heading = {
	slug: string;
	text: string;
	depth: number;
};

type Props = CollectionEntry<'blog'>['data'] & {headings?: Heading[];};

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;

// 是否有足够的目录项（H2/H3 至少 1 个），决定是否启用目录侧边栏布局
const hasToc = headings.some((h) => h.depth >= 2 && h.depth <= 3);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* 只有博客文章页（有目录）才覆盖 main 宽度，
			   容纳正文 720px + 目录 260px + 间距；
			   about 页等无目录页面保持 global.css 的 720px 居中 */
			:global(body.has-toc main) {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
				padding: 3em 1em;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			/* 文章正文 + 目录侧边栏布局（仅 has-toc 页面启用）：
			   正文保持 720px 可读性，目录放在正文右侧的边距区域。
			   align-items: stretch 让目录列拉伸到与正文等高，
			   内部 sticky 目录才有空间"粘"在视口内。 */
			.article-layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 720px) 260px minmax(0, 1fr);
				gap: 0 2.5rem;
				align-items: stretch;
				max-width: 1280px;
				margin: 0 auto;
			}

			.article-content {
				grid-column: 2;
				min-width: 0;
				padding: 0 1em;
				color: rgb(var(--gray-dark));
			}
			.article-content :global(p) {
				margin-bottom: 2em;
			}

			.article-toc {
				grid-column: 3;
			}

			@media (max-width: 1100px) {
				.article-layout {
					grid-template-columns: minmax(0, 1fr) minmax(0, 720px) minmax(0, 1fr);
				}
				.article-content {
					grid-column: 2;
				}
				.article-toc {
					display: none;
				}
			}

			@media (max-width: 768px) {
				.article-layout {
					display: block;
				}
				.article-toc {
					display: block;
				}
			}
		</style>
	</head>

	<body class={hasToc ? 'has-toc' : ''}>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
				</div>

				{
					hasToc ? (
						<div class="article-layout">
							<div class="article-content">
								<slot />
							</div>
							<aside class="article-toc">
								<TableOfContents headings={headings} />
							</aside>
						</div>
					) : (
						<div class="prose">
							<slot />
						</div>
					)
				}

				<div class="prose">
					<Giscus />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

