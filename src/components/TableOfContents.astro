---
interface Heading { slug: string; text: string; depth: number }
interface Props { headings: Heading[] }

const toc = (Astro.props.headings ?? []).filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{toc.length > 0 && (
	<details class="toc" open>
		<summary class="toc-title">文章目录<span class="toc-count">{toc.length} 个章节</span><span class="toc-chevron" aria-hidden="true">⌄</span></summary>
		<nav aria-label="文章目录"><ul class="toc-list">
			{toc.map((heading) => <li class:list={[`depth-${heading.depth}`]}><a href={`#${heading.slug}`} data-slug={heading.slug}>{heading.text}</a></li>)}
		</ul></nav>
	</details>
)}

<style>
	.toc { position: sticky; top: 5.5rem; max-height: calc(100vh - 7rem); overflow-y: auto; padding: 1rem; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); color: rgb(var(--gray-dark)); font-size: 0.82rem; }
	.toc-title { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; padding-bottom: 0.7rem; border-bottom: 1px solid var(--color-border); color: rgb(var(--black)); font-size: 0.82rem; font-weight: 700; cursor: pointer; list-style: none; }
	.toc-title::-webkit-details-marker { display: none; }
	.toc-count { margin-left: auto; color: rgb(var(--gray)); font-size: 0.68rem; font-weight: 400; }
	.toc-chevron { color: rgb(var(--gray)); transition: transform 0.2s ease; }
	.toc[open] .toc-chevron { transform: rotate(180deg); }
	.toc:not([open]) .toc-title { margin: 0; padding: 0; border: 0; }
	.toc-list { margin: 0; padding: 0; border-left: 1px solid var(--color-border); list-style: none; }
	.toc-list li { margin: 0; line-height: 1.45; }
	.toc-list a { display: block; margin-left: -1px; padding: 0.34rem 0 0.34rem 0.8rem; border-left: 2px solid transparent; color: rgb(var(--gray)); text-decoration: none; transition: color 0.16s ease, border-color 0.16s ease; }
	.toc-list a:hover,
	.toc-list a.is-active { border-left-color: var(--accent); color: var(--accent); }
	.toc-list a.is-active { font-weight: 650; }
	.toc-list li.depth-3 a { padding-left: 1.45rem; font-size: 0.75rem; }
	@media (max-width: 1120px) {
		.toc { position: static; max-height: none; margin: 0; padding: 0.9rem 1rem; }
	}
</style>

<script>
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-list a'));
	const disclosure = document.querySelector<HTMLDetailsElement>('details.toc');
	const mobile = window.matchMedia('(max-width: 1120px)');
	if (disclosure && mobile.matches) disclosure.open = false;
	mobile.addEventListener('change', (event) => { if (disclosure) disclosure.open = !event.matches; });
	links.forEach((link) => link.addEventListener('click', () => { if (mobile.matches && disclosure) disclosure.open = false; }));

	const headingElements = links
		.map((link) => document.getElementById(link.dataset.slug ?? ''))
		.filter((element): element is HTMLElement => element !== null);
	if (headingElements.length > 0 && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				links.forEach((link) => link.classList.toggle('is-active', link.dataset.slug === entry.target.id));
			}
		}, { rootMargin: '-90px 0px -70% 0px', threshold: 0 });
		headingElements.forEach((element) => observer.observe(element));
	}
</script>
