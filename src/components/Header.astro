---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SearchModal from './SearchModal.astro';
---

<header>
	<nav>
		<div class="nav-left">
			<h2><a href="/">{SITE_TITLE}</a></h2>
			<div class="internal-links">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">博客</HeaderLink>
				<HeaderLink href="/docs">Docs</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
		</div>
		<div class="nav-right">
			<!-- 搜索按钮：点击唤起模态框搜索 -->
			<button id="search-toggle" class="search-toggle" type="button" aria-label="搜索 (Ctrl+K)">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242.156a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"
					></path>
				</svg>
				<span class="search-hint">搜索</span>
				<kbd class="search-kbd">⌘K</kbd>
			</button>
			<div class="social-links">
				<a href="https://github.com/wzd9" target="_blank">
					<span class="sr-only">GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
				<a href="/rss.xml">
					<span class="sr-only">RSS 订阅</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
						><path
							fill="currentColor"
							d="M2 2v2.13c5.46 0 9.87 4.41 9.87 9.87H14C14 7.37 8.63 2 2 2zm0 4.4v2.13c3.03 0 5.47 2.45 5.47 5.47h2.13c0-4.2-3.4-7.6-7.6-7.6zM4.13 12a2.13 2.13 0 1 1-4.26 0 2.13 2.13 0 0 1 4.26 0z"
							transform="translate(1 1)"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
</header>

<!-- 模态框组件（只在有搜索需求的页面渲染） -->
<SearchModal />

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.5em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.nav-left {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	h2 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
		white-space: nowrap;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	/* 搜索按钮 */
	.search-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4em 0.8em;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		background: #f4f4f5;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		cursor: pointer;
		transition: all 0.2s;
		font-family: inherit;
	}
	.search-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: #eef1ff;
	}
	.search-kbd {
		font-size: 0.7rem;
		padding: 0.05em 0.3em;
		border-radius: 4px;
		border: 1px solid rgb(var(--gray-light));
		background: #fff;
		color: rgb(var(--gray));
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
	.search-hint {
		display: none;
	}
	/* 宽度够时显示"搜索"文字 */
	@media (min-width: 900px) {
		.search-hint {
			display: inline;
		}
	}

	.social-links,
	.social-links a {
		display: flex;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 0.75em;
		}
		.nav-left {
			gap: 0.5rem;
		}
		h2 {
			font-size: 1rem;
		}
		nav a {
			padding: 0.9em 0.4em;
		}
		.search-toggle {
			padding: 0.35em 0.5em;
			border-radius: 6px;
		}
		.search-kbd {
			display: none;
		}
		.social-links {
			display: none;
		}
	}
</style>

<script>
	// 点击搜索按钮打开模态框
	const btn = document.getElementById('search-toggle');
	btn?.addEventListener('click', () => {
		document.dispatchEvent(new CustomEvent('open-search-modal'));
	});
</script>
