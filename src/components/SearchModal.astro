---
// 全站搜索模态框，使用 Pagefind UI（Astro 生态推荐的静态搜索）
// 只在构建产物中生效（npm run build + npx pagefind --site dist）
// dev 模式下不做任何事，避免报错
---

<!-- 模态遮罩层 -->
<div
	class="search-modal"
	id="search-modal"
	aria-hidden="true"
	role="dialog"
	aria-label="全站搜索"
>
	<div class="search-modal-backdrop" data-close-modal></div>
	<div class="search-modal-panel">
		<!-- Pagefind UI 挂载点 -->
		<div id="pagefind-ui" class="pagefind-ui"></div>
		<!-- Dev 模式下的提示（Pagefind 仅在构建后可用） -->
		{!import.meta.env.PROD && (
			<div class="search-dev-tip">
				<div class="tip-header">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm9-3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-.25 2.75a.75.75 0 0 0-1.5 0v2.5a.75.75 0 0 0 1.5 0v-2.5z"></path>
					</svg>
					提示
				</div>
				<p>站内搜索基于 <strong>Pagefind</strong> 实现，<strong>仅在构建后生效</strong>。</p>
				<p class="tip-detail">
					请先执行 <code>npm run build</code> 构建项目，再通过 <code>npm run preview</code> 预览搜索功能。
				</p>
			</div>
		)}
	</div>
</div>

<style is:global>
	.search-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: none;
	}
	.search-modal.is-open {
		display: block;
	}
	.search-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 23, 42, 0.55);
		backdrop-filter: blur(2px);
		animation: fadeIn 0.15s ease-out;
	}
	.search-modal-panel {
		position: relative;
		max-width: 720px;
		width: calc(100% - 3rem);
		margin: 8vh auto 0;
		background: #fff;
		border-radius: 12px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
		max-height: 80vh;
		overflow: hidden;
		animation: slideDown 0.18s ease-out;
	}
	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}
	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	/* 覆盖 Pagefind UI 默认样式，与博客风格统一 */
	.pagefind-ui {
		font-family: inherit;
		margin: 0;
		padding: 0;
		--pagefind-ui-font: inherit;
	}
	.pagefind-ui__form {
		margin: 0;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.pagefind-ui__search-input {
		border: none;
		outline: none;
		font-size: 1.05rem;
		padding: 0.6rem 0.4rem;
		background: transparent;
	}
	.pagefind-ui__search-input::placeholder {
		color: rgb(var(--gray));
	}
	.pagefind-ui__results-area {
		padding: 0.25rem 0 0.5rem;
		max-height: 60vh;
		overflow-y: auto;
	}
	.pagefind-ui__message {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		padding: 0.5rem 0.9rem;
	}
	.pagefind-ui__result {
		padding: 0.45rem 0.9rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.pagefind-ui__result:last-child {
		border-bottom: none;
	}
	.pagefind-ui__result-title {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		line-height: 1.4;
	}
	.pagefind-ui__result-title:hover {
		text-decoration: underline;
	}
	.pagefind-ui__result-excerpt {
		font-size: 0.82rem;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
		margin-top: 0.2rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.pagefind-ui__result-highlight {
		background: #ffe066;
		color: #1a1a1a;
		padding: 0 1px;
		border-radius: 2px;
		font-weight: 600;
	}
	.pagefind-ui__drawer {
		height: auto;
	}

	/* Dev 模式提示样式 */
	.search-dev-tip {
		padding: 1.5rem 1.2rem;
		text-align: center;
		color: rgb(var(--gray-dark));
	}
	.search-dev-tip .tip-header {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 0.8rem;
	}
	.search-dev-tip p {
		margin: 0.4rem 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.search-dev-tip .tip-detail {
		margin-top: 0.8rem;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.search-dev-tip code {
		padding: 0.15em 0.4em;
		background: #f4f4f5;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 0.82em;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
</style>

<!-- Pagefind UI 只在构建产物中存在，dev 模式下这些文件不会生成
     用 import.meta.env.PROD 条件化输出，避免 dev 模式下 404 -->
{
	import.meta.env.PROD && (
		<>
			<link is:inline rel="stylesheet" href="/pagefind/pagefind-ui.css" />
			<script is:inline src="/pagefind/pagefind-ui.js"></script>
		</>
	)
}

<script>
	// Pagefind 只在构建产物中可用（astro build 后 Starlight 自动生成 dist/pagefind/*）
	let pagefindInit = false;

	function openModal() {
		const modal = document.getElementById('search-modal');
		if (!modal) return;
		modal.classList.add('is-open');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		// 首次打开时初始化 Pagefind UI
		if (!pagefindInit && typeof window.PagefindUI === 'function') {
			try {
				new window.PagefindUI({ element: document.querySelector('#pagefind-ui') });
				pagefindInit = true;
			} catch { /* 静默 */ }
		}
		// 聚焦搜索框
		setTimeout(() => {
			const input = document.querySelector('.pagefind-ui__search-input');
			input?.focus();
		}, 200);
	}

	function closeModal() {
		const modal = document.getElementById('search-modal');
		if (!modal) return;
		modal.classList.remove('is-open');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	document.addEventListener('DOMContentLoaded', () => {
		// 全局快捷键：Cmd/Ctrl + K 打开搜索
		document.addEventListener('keydown', (e) => {
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
				e.preventDefault();
				openModal();
			} else if (e.key === 'Escape') {
				closeModal();
			}
		});
		// 点击遮罩关闭
		document.addEventListener('click', (e) => {
			if (e.target.hasAttribute('data-close-modal')) closeModal();
		});
		// 监听 Header 发出的打开事件
		document.addEventListener('open-search-modal', openModal);
	});
</script>
